{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role and credit details",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "credits": { "type": "number" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "email"]
    },
    "ThemeSettings": {
      "title": "ThemeSettings",
      "description": "Global custom theme configuration",
      "type": "object",
      "properties": {
        "theme": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["theme"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Stored user profiles"
    },
    "settings/theme": {
      "schema": "ThemeSettings",
      "description": "System-wide brand configuration"
    }
  }
}
